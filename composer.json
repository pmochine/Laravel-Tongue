{
  "name": "pmochine/laravel-tongue",
  "description": "🎉 Finally a subdomain localization that works how you want it to work. 🌐",
  "license": "MIT",
  "keywords": [
    "laravel",
    "tongue",
    "localization",
    "subdomain",
    "i18n",
    "package",
    "language"
  ],
  "type": "library",
  "authors": [
    {
      "name": "Philipp Mochine",
      "email": "mail@philippmochine.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "bakame/laravel-domain-parser": "^1.3",
    "laravel/framework": "^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5.3 || ^12.5.8 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Pmochine\\LaravelTongue\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pmochine\\LaravelTongue\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pmochine\\LaravelTongue\\ServiceProvider"
      ]
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  }
}
